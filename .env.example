# =========================================================
# CATORCE Sales OS - 環境変数
# =========================================================
# ローカル開発時は .env.local にコピーして値を設定してください。
# Vercel ではプロジェクトの Environment Variables に同じものを設定します。

# Supabase プロジェクトの URL と anon(公開)キー ※クライアントにも露出する公開値
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key...

# service role(秘密)キー ※サーバー専用。メンバー(社員アカウント)発行に使用。
# 絶対に公開・コミットしないこと。Vercel では "Sensitive" 扱いで登録。
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key...

# AI機能(将来)で利用するキー
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# Slack通知(毎朝の営業ダイジェスト)。未設定なら送信スキップ。
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# Vercel Cron の認可シークレット(任意・推奨)
# CRON_SECRET=

# エラー監視(Sentry)。DSN未設定なら完全に無効(no-op)。
# NEXT_PUBLIC_SENTRY_DSN=https://xxxx@oXXXX.ingest.sentry.io/XXXX
# ソースマップをSentryへ上げる場合のみ(ビルド時)
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# D-1 Webフォーム→リード取込。未設定なら /api/lead-intake は無効(503)。
# HPのフォームから x-intake-token ヘッダー(または token フィールド)で送信。
# LEAD_INTAKE_SECRET=
# CORSで許可するオリジン(既定 *)
# LEAD_INTAKE_ALLOW_ORIGIN=https://www.example.co.jp

# D-2 カレンダー連携(ICSフィード)。未設定なら /api/calendar は無効。
# Googleカレンダー「URLで追加」: https://<APP>/api/calendar?token=<この値>
# CALENDAR_FEED_TOKEN=

# D-4 AI支援(議事録AI要約)。設定すると商談詳細の「AIで要約」が有効に。
# ANTHROPIC_API_KEY=

# =========================================================
# freee 会計 連携 (docs/FREEE_INTEGRATION_DESIGN_2026-07.md)
# =========================================================
# freeeアプリストアで「アプリ」を作成し、Client ID / Secret を取得。
# コールバックURLには <APP>/api/freee/callback を登録する。
# 3つとも未設定なら freee連携は無効（設定画面で「接続」時にエラー表示）。
# FREEE_CLIENT_ID=
# FREEE_CLIENT_SECRET=          ※サーバー専用・秘匿。Vercelでは Sensitive 登録。
# FREEE_REDIRECT_URI=https://YOUR-APP.vercel.app/api/freee/callback
# アプリの絶対URL（OAuthリダイレクト先の組み立てに使用）
# NEXT_PUBLIC_APP_URL=https://YOUR-APP.vercel.app
