# =========================================================
# CATORCE Sales OS - 環境変数
# =========================================================
# ローカル開発時は .env.local にコピーして値を設定してください。
# Vercel ではプロジェクトの Environment Variables に同じものを設定します。

# Supabase プロジェクトの URL と anon(公開)キー ※クライアントにも露出する公開値
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key...

# service role(秘密)キー ※サーバー専用。メンバー(社員アカウント)発行に使用。
# 絶対に公開・コミットしないこと。Vercel では "Sensitive" 扱いで登録。
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key...

# AI機能(将来)で利用するキー
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# Slack通知(毎朝の営業ダイジェスト)。未設定なら送信スキップ。
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# Vercel Cron の認可シークレット(任意・推奨)
# CRON_SECRET=

# エラー監視(Sentry)。DSN未設定なら完全に無効(no-op)。
# NEXT_PUBLIC_SENTRY_DSN=https://xxxx@oXXXX.ingest.sentry.io/XXXX
# ソースマップをSentryへ上げる場合のみ(ビルド時)
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# D-1 Webフォーム→リード取込。未設定なら /api/lead-intake は無効(503)。
# HPのフォームから x-intake-token ヘッダー(または token フィールド)で送信。
# 流入元は既定で「HP問合せ」。フォーム側で source フィールドを送れば上書き可。
# LEAD_INTAKE_SECRET=
# CORSで許可するオリジン(既定 *。本番はHPのオリジンに絞ることを推奨)
# LEAD_INTAKE_ALLOW_ORIGIN=https://www.example.co.jp

# reCAPTCHA サーバー検証(スパム対策の上乗せ)。設定するとフォームからの
# reCAPTCHAトークン(g-recaptcha-response 等)を必須で検証する。未設定なら検証しない。
# ※これは「シークレットキー」。サイトキー(公開)はHP側に置く別物。絶対に公開しないこと。
# RECAPTCHA_SECRET=
# v3のスコア足切り閾値(既定 0.5。v2チェックボックスでは無視)。
# RECAPTCHA_MIN_SCORE=0.5

# D-1b 問い合わせ通知メール(自動返信+社内通知)のシステムSMTP。
# 未設定ならメールは送らずスキップ(アプリ内通知/Slackは動く)。no-reply 等の共有箱を推奨。
# SYSTEM_SMTP_HOST=smtp.gmail.com
# SYSTEM_SMTP_PORT=465            # 465=SSL / 587=STARTTLS
# SYSTEM_SMTP_SECURE=true         # 省略時はポートから推定(465→true)
# SYSTEM_SMTP_USER=no-reply@catorce.jp
# SYSTEM_SMTP_PASS=xxxx-xxxx-xxxx-xxxx   # アプリパスワード等
# SYSTEM_MAIL_FROM=no-reply@catorce.jp   # 省略時は SYSTEM_SMTP_USER
# SYSTEM_MAIL_FROM_NAME=株式会社カトルセ
# 自動返信の Reply-To(顧客の返信先。有人アドレス)。未設定なら送信専用のまま。
# INQUIRY_REPLY_TO=info@catorce.jp
# 社内通知の宛先(カンマ区切り)。未設定なら owner/admin/sales_manager のログインメールへ。
# INQUIRY_NOTIFY_EMAILS=sales@catorce.jp,ops@catorce.jp
# メール本文の差出人組織名(既定 株式会社カトルセ)。
# INQUIRY_ORG_NAME=株式会社カトルセ

# D-2 カレンダー連携(ICSフィード)。未設定なら /api/calendar は無効。
# Googleカレンダー「URLで追加」: https://<APP>/api/calendar?token=<この値>
# CALENDAR_FEED_TOKEN=

# D-4 AI支援(議事録AI要約)。設定すると商談詳細の「AIで要約」が有効に。
# ANTHROPIC_API_KEY=

# 資格情報を暗号化する共通鍵(AES-256-GCM)。次の2つで使用します。
#   ・F-101 メール送信アカウント(SMTP/OAuth)のアプリパスワード・リフレッシュトークン
#   ・設定→Googleカレンダー連携 の「非公開URL(iCal形式)」
#     → マインドマップの週次予定にカレンダーを取り込むために必要。未設定だとURLを保存できません。
# 十分に長いランダム文字列を設定してください(例: openssl rand -base64 48)。変更すると既存接続は再入力が必要。
# MAIL_CRED_SECRET=
# トラッキング(開封/クリック)のリンク生成に使う公開URL。未設定だと相対的な計測URLになり計測が不安定に。
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# F-101 経路①: Google Workspace のOAuth接続(Gmail API送受信)。GWSユーザーがアプリパスワード
# 不要で接続できるようにする。Google Cloud で OAuth クライアント(種別=ウェブアプリ)を作成し、
# アプリを「内部(Internal)」に設定、スコープに gmail.readonly / gmail.send / userinfo.email を許可。
# 承認済みリダイレクトURIに <NEXT_PUBLIC_APP_URL>/api/oauth/google/callback を登録すること。
# 未設定なら「Googleで接続」ボタンは無効(SMTP方式は引き続き利用可)。
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# =========================================================
# Google Chat 連携（Bot / Service Account）
# 設計: docs/GOOGLE_CHAT_INTEGRATION_DESIGN_2026-07.md
# 管理者手順: docs/GOOGLE_CHAT_SETUP_GUIDE_2026-07.md
# =========================================================
# P1(送信): Chat App のアプリ認証に使う Service Account 資格情報。
# サービスアカウントJSONを「そのまま1行化」または「Base64化」して設定。
# 秘密。Vercel では "Sensitive" 扱いで登録。未設定なら Chat 連携は完全に no-op。
# GOOGLE_CHAT_SA_CREDENTIALS=

# P2/P3(受信) 用（送信のみのP1では不要）:
# 受信の正当性検証に使う Google Cloud プロジェクト番号（Bearer JWT の audience）。
# GOOGLE_CHAT_PROJECT_NUMBER=
# リアクション購読の通知先 Pub/Sub トピック。
# GOOGLE_CHAT_PUBSUB_TOPIC=projects/<project-id>/topics/chat-events
# Pub/Sub Push の OIDC 検証で期待する audience（= /api/chat/pubsub の絶対URL）。
# GOOGLE_CHAT_PUBSUB_AUDIENCE=https://<APP>/api/chat/pubsub

# 案件コメントのGoogle Chat通知（メンションなしコメントの配信先スペース。省略時はコード内既定値）
# GOOGLE_CHAT_COMMENT_SPACE=spaces/AAQAIyCd7LY
