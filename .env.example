# =========================================================
# CATORCE Sales OS - 環境変数
# =========================================================
# ローカル開発時は .env.local にコピーして値を設定してください。
# Vercel ではプロジェクトの Environment Variables に同じものを設定します。

# Supabase プロジェクトの URL と anon(公開)キー ※クライアントにも露出する公開値
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key...

# service role(秘密)キー ※サーバー専用。メンバー(社員アカウント)発行に使用。
# 絶対に公開・コミットしないこと。Vercel では "Sensitive" 扱いで登録。
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key...

# AI機能(将来)で利用するキー
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
