# =========================================================
# CATORCE Sales OS - 環境変数サンプル
# =========================================================
#
# 既定では Supabase 未設定でも「デモモード」で起動します。
# (CATORCE初期テンプレート + サンプル商談データをメモリ上で利用)
#
# 本番運用で Supabase を利用する場合は以下を設定してください。
# 設定すると自動的に Supabase モードに切り替わります。

# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx...
# SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx...

# AI機能(将来)で利用するキー
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
